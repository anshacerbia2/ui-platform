{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/dialog",
  "entryKind": "interactive",
  "stability": "candidate",
  "primitive": "DialogBase",
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-dialog",
      "primitivePart": "dialog"
    },
    {
      "name": "backdrop",
      "selector": ".scnx-dialog::backdrop"
    },
    {
      "name": "title",
      "selector": ".scnx-dialog > [data-part=title]",
      "primitivePart": "title"
    },
    {
      "name": "description",
      "selector": ".scnx-dialog > [data-part=description]",
      "primitivePart": "description"
    }
  ],
  "options": {},
  "states": [],
  "fixture": {
    "activate": "showModal",
    "tree": {
      "type": "Dialog",
      "props": {
        "open": false
      },
      "children": [
        {
          "type": "Dialog.Title",
          "children": [
            "Delete run"
          ]
        },
        {
          "type": "Dialog.Description",
          "children": [
            "The run and its logs are removed."
          ]
        }
      ]
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "padding": "{dimension.spacing.inset.comfortable}",
        "border": "{dimension.border.width.default} solid {color.neutral.border.subtle.default}",
        "border-radius": "{dimension.radius.container}",
        "background": "{color.neutral.surface.floating.default}",
        "color": "{color.neutral.text.default.default}",
        "box-shadow": "{effect.shadow.overlay}"
      }
    },
    {
      "part": "backdrop",
      "declarations": {
        "background": "color-mix(in oklch, {color.neutral.shadow.strong.default} 55%, transparent)"
      }
    },
    {
      "part": "title",
      "declarations": {
        "font-family": "{typography.heading.small.font-family}",
        "font-size": "{typography.heading.small.font-size}",
        "font-weight": "{typography.heading.small.font-weight}",
        "line-height": "{typography.heading.small.line-height}",
        "letter-spacing": "{typography.heading.small.letter-spacing}",
        "margin": "0 0 {dimension.spacing.stack.compact}"
      }
    },
    {
      "part": "description",
      "declarations": {
        "font-family": "{typography.body.default.font-family}",
        "font-size": "{typography.body.default.font-size}",
        "font-weight": "{typography.body.default.font-weight}",
        "line-height": "{typography.body.default.line-height}",
        "letter-spacing": "{typography.body.default.letter-spacing}",
        "color": "{color.neutral.text.subtle.default}",
        "margin": "0 0 {dimension.spacing.stack.default}"
      }
    }
  ]
}
