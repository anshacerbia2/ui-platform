{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/dialog",
  "entryKind": "interactive",
  "stability": "candidate",
  "primitive": "DialogBase",
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-dialog",
      "primitivePart": "dialog"
    },
    {
      "name": "backdrop",
      "selector": ".scnx-dialog::backdrop"
    },
    {
      "name": "title",
      "selector": ".scnx-dialog > [data-part=title]",
      "primitivePart": "title"
    },
    {
      "name": "description",
      "selector": ".scnx-dialog > [data-part=description]",
      "primitivePart": "description"
    },
    {
      "name": "body",
      "selector": ".scnx-dialog > [data-part=body]"
    },
    {
      "name": "actions",
      "selector": ".scnx-dialog > [data-part=actions]"
    },
    {
      "name": "close",
      "selector": ".scnx-dialog > [data-part=close][data-corner]",
      "primitivePart": "close"
    }
  ],
  "options": {},
  "states": [],
  "fixture": {
    "activate": "showModal",
    "tree": {
      "type": "Dialog",
      "props": {
        "open": false
      },
      "children": [
        {
          "type": "Dialog.Title",
          "children": [
            "Delete run"
          ]
        },
        {
          "type": "Dialog.Description",
          "children": [
            "The run and its logs are removed."
          ]
        },
        {
          "type": "Dialog.Body",
          "children": [
            "Payslips already sent stay with their recipients."
          ]
        },
        {
          "type": "Dialog.Actions",
          "children": [
            {
              "type": "Dialog.Close",
              "props": {
                "variant": "ghost"
              },
              "children": [
                "Cancel"
              ]
            }
          ]
        },
        {
          "type": "Dialog.CloseButton"
        }
      ]
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "padding": "{dimension.spacing.inset-comfortable}",
        "border": "{dimension.border-width.default} solid transparent",
        "border-radius": "{dimension.radius.panel}",
        "background": "{color.neutral.surface.floating.default}",
        "color": "{color.neutral.text.default.default}",
        "box-shadow": "{effect.material.modal}"
      }
    },
    {
      "part": "backdrop",
      "declarations": {
        "background": "{color.neutral.shadow.strong.default}"
      }
    },
    {
      "part": "title",
      "declarations": {
        "font-family": "{typography.heading.small.font-family}",
        "font-size": "{typography.heading.small.font-size}",
        "font-weight": "{typography.heading.small.font-weight}",
        "line-height": "{typography.heading.small.line-height}",
        "letter-spacing": "{typography.heading.small.letter-spacing}",
        "margin": "0 0 {dimension.spacing.stack-compact}",
        "padding-inline-end": "{dimension.spacing.inset-comfortable}"
      }
    },
    {
      "part": "description",
      "declarations": {
        "font-family": "{typography.body.default.font-family}",
        "font-size": "{typography.body.default.font-size}",
        "font-weight": "{typography.body.default.font-weight}",
        "line-height": "{typography.body.default.line-height}",
        "letter-spacing": "{typography.body.default.letter-spacing}",
        "color": "{color.neutral.text.subtle.default}",
        "margin": "0 0 {dimension.spacing.stack-default}"
      }
    },
    {
      "part": "body",
      "declarations": {
        "margin-block-end": "{dimension.spacing.stack-comfortable}"
      }
    },
    {
      "part": "actions",
      "declarations": {
        "gap": "{dimension.spacing.inline-default}"
      }
    },
    {
      "part": "close",
      "declarations": {
        "inset-block-start": "{dimension.spacing.inset-default}",
        "inset-inline-end": "{dimension.spacing.inset-default}"
      }
    }
  ]
}
