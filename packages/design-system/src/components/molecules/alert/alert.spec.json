  "hookScope": "Set a hook on a scope the product owns, not on :root, so a runtime change restyles that scope only. To change one scheme only, set the hook on [data-scheme] within the scope, for example .promo [data-scheme=\"neutral\"] { --scnx-alert-actions-gap: …; }; without it, the hook applies to every scheme in the scope.",
  "hooks": [
    {
      "hook": "--scnx-alert-actions-gap",
      "parts": [
        "actions"
      ],
      "properties": [
        "gap"
      ],
      "fallbacks": [
        "{dimension.spacing.inline-compact}"
      ],
      "floor": null,
      "purpose": "The gap of Alert's actions part.",
      "coverage": "scnx-platform and scnx-saas, light and dark; every scheme value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-alert-background",
      "parts": [
        "root"
      ],
      "properties": [
        "background-color"
      ],
      "fallbacks": [
        "{color.danger.surface.subtle.default}",
        "{color.info.surface.subtle.default}",
        "{color.neutral.surface.subtle.default}",
        "{color.success.surface.subtle.default}",
        "{color.warning.surface.subtle.default}"
      ],
