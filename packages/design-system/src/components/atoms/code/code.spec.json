{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/code",
  "entryKind": "presentational",
  "stability": "candidate",
  "primitive": null,
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-code"
    }
  ],
  "options": {
    "intent": {
      "values": [
        "primary",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "default": null,
      "selector": ".scnx-code--intent_{value}"
    }
  },
  "states": [],
  "fixture": {
    "props": {
      "children": "pnpm add @scnx/system"
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "border-width": "{dimension.border-width.default}",
        "border-color": "{color.neutral.border.subtle.default}",
        "border-radius": "{dimension.radius.mark}",
        "font-family": "{typography.code.default.font-family}",
        "font-weight": "{typography.weight.medium}",
        "background-color": "{color.neutral.surface.subtle.default}",
        "color": "inherit"
      }
    },
    {
      "part": "root",
      "option": {
        "intent": "primary"
      },
      "declarations": {
        "border-color": "{color.primary.border.default.default}",
        "color": "{color.primary.text.default.default}",
        "background-color": "{color.primary.surface.subtle.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "intent": "info"
      },
      "declarations": {
        "border-color": "{color.info.border.default.default}",
        "color": "{color.info.text.default.default}",
        "background-color": "{color.info.surface.subtle.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "intent": "success"
      },
      "declarations": {
        "border-color": "{color.success.border.default.default}",
        "color": "{color.success.text.default.default}",
        "background-color": "{color.success.surface.subtle.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "intent": "warning"
      },
      "declarations": {
        "border-color": "{color.warning.border.default.default}",
        "color": "{color.warning.text.default.default}",
        "background-color": "{color.warning.surface.subtle.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "intent": "danger"
      },
      "declarations": {
        "border-color": "{color.danger.border.default.default}",
        "color": "{color.danger.text.default.default}",
        "background-color": "{color.danger.surface.subtle.default}"
      }
    }
  ],
  "hookScope": "Set a hook on a scope the product owns, not on :root, so a runtime change restyles that scope only, for example .promo { --scnx-code-background: …; }.",
  "hooks": [
    {
      "hook": "--scnx-code-background",
      "parts": [
        "root"
      ],
      "properties": [
        "background-color"
      ],
      "fallbacks": [
        "{color.danger.surface.subtle.default}",
        "{color.info.surface.subtle.default}",
        "{color.neutral.surface.subtle.default}",
        "{color.primary.surface.subtle.default}",
        "{color.success.surface.subtle.default}",
        "{color.warning.surface.subtle.default}"
      ],
      "floor": null,
      "purpose": "The background-color of Code.",
      "coverage": "industrial and achromatic, light and dark; every intent value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-code-border-color",
      "parts": [
        "root"
      ],
      "properties": [
        "border-color"
      ],
      "fallbacks": [
        "{color.danger.border.default.default}",
        "{color.info.border.default.default}",
        "{color.neutral.border.subtle.default}",
        "{color.primary.border.default.default}",
        "{color.success.border.default.default}",
        "{color.warning.border.default.default}"
      ],
      "floor": null,
      "purpose": "The border-color of Code.",
      "coverage": "industrial and achromatic, light and dark; every intent value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-code-border-width",
      "parts": [
        "root"
      ],
      "properties": [
        "border-width"
      ],
      "fallbacks": [
        "{dimension.border-width.default}"
      ],
      "floor": null,
      "purpose": "The border-width of Code.",
      "coverage": "industrial and achromatic, light and dark; every intent value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-code-color",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.danger.text.default.default}",
        "{color.info.text.default.default}",
        "{color.primary.text.default.default}",
        "{color.success.text.default.default}",
        "{color.warning.text.default.default}"
      ],
