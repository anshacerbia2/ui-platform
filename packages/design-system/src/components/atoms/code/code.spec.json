      "coverage": "industrial and achromatic, light and dark; every intent value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-code-font-family",
      "parts": [
        "root"
      ],
      "properties": [
        "font-family"
      ],
      "fallbacks": [
        "{typography.code.default.font-family}"
      ],
      "floor": null,
      "purpose": "The font-family of Code.",
      "coverage": "industrial and achromatic, light and dark; every intent value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
