{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/badge",
  "entryKind": "presentational",
  "stability": "candidate",
  "primitive": null,
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-badge"
    }
  ],
  "options": {
    "scheme": {
      "values": [
        "neutral",
        "primary",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "default": "neutral",
      "selector": "[data-scheme={value}]"
    },
    "emphasis": {
      "values": [
        "subtle",
        "solid"
      ],
      "default": "subtle",
      "selector": "[data-emphasis={value}]"
    },
    "size": {
      "values": [
        "small",
        "medium"
      ],
      "default": "medium",
      "selector": "[data-size={value}]"
    }
  },
  "states": [],
  "fixture": {
    "props": {
      "children": "Beta"
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "gap": "{dimension.spacing.inline-compact}",
        "border": "{dimension.border-width.default} solid transparent",
        "border-radius": "{dimension.radius.element}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "medium"
      },
      "declarations": {
        "font-family": "{typography.label.default.font-family}",
        "font-size": "{typography.label.default.font-size}",
        "font-weight": "{typography.label.default.font-weight}",
        "line-height": "{typography.label.default.line-height}",
        "letter-spacing": "{typography.label.default.letter-spacing}",
        "padding": "0 {dimension.spacing.inline-default}"
      }
    },
    {
      "part": "root",
