        "letter-spacing": "{typography.label.small.letter-spacing}",
        "padding": "0 {dimension.spacing.inline-compact}",
        "border-radius": "{dimension.radius.mark}"
      }
    },
    {
      "part": "root",
      "option": {
        "scheme": "neutral",
        "emphasis": "subtle"
      },
      "declarations": {
