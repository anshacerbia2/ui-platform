  "hookScope": "Set a hook on a scope the product owns, not on :root, so a runtime change restyles that scope only. To change one scheme only, set the hook on [data-scheme] within the scope, for example .promo [data-scheme=\"primary\"] { --scnx-badge-background: …; }; without it, the hook applies to every scheme in the scope.",
  "hooks": [
    {
      "hook": "--scnx-badge-background",
      "parts": [
        "root"
      ],
      "properties": [
        "background-color"
      ],
      "fallbacks": [
        "{color.danger.surface.default.default}",
        "{color.danger.surface.solid.default}",
        "{color.info.surface.default.default}",
        "{color.info.surface.solid.default}",
        "{color.neutral.surface.default.default}",
        "{color.neutral.surface.solid.default}",
        "{color.primary.surface.default.default}",
        "{color.primary.surface.solid.default}",
        "{color.success.surface.default.default}",
        "{color.success.surface.solid.default}",
        "{color.warning.surface.default.default}",
        "{color.warning.surface.solid.default}"
      ],
      "floor": null,
      "purpose": "The background-color of Badge.",
      "coverage": "scnx-platform and scnx-saas, light and dark; every scheme, emphasis and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
