{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/badge",
  "entryKind": "presentational",
  "stability": "candidate",
  "primitive": null,
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-badge"
    },
    {
      "name": "dot",
      "selector": ".scnx-badge > [data-part=dot]"
    }
  ],
  "options": {
    "scheme": {
      "values": [
        "neutral",
        "primary",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "default": "neutral",
      "selector": "[data-scheme={value}]"
    },
    "emphasis": {
      "values": [
        "subtle",
        "solid"
      ],
      "default": "subtle",
      "selector": "[data-emphasis={value}]"
    },
    "size": {
      "values": [
        "small",
        "medium"
      ],
      "default": "medium",
      "selector": "[data-size={value}]"
    }
  },
  "states": [],
  "fixture": {
    "props": {
      "children": "Beta",
      "dot": true
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "gap": "{dimension.spacing.inline-compact}",
        "border": "{dimension.border-width.default} solid transparent",
        "border-radius": "{dimension.radius.element}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "medium"
      },
