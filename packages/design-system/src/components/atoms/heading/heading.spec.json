{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/heading",
  "entryKind": "presentational",
  "stability": "candidate",
  "primitive": null,
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-heading"
    }
  ],
  "options": {
    "size": {
      "values": [
        "xxlarge",
        "xlarge",
        "large",
        "medium",
        "small",
        "xsmall"
      ],
      "default": "medium",
      "selector": ".scnx-heading--size_{value}"
    },
    "weight": {
      "values": [
        "bold",
        "semibold",
        "medium",
        "regular"
      ],
      "default": "bold",
      "selector": ".scnx-heading--weight_{value}"
    }
  },
  "states": [],
  "fixture": {
    "props": {
      "children": "Payroll runs"
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "color": "{color.neutral.text.default.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "medium"
      },
      "declarations": {
        "font-family": "{typography.heading.medium.font-family}",
        "font-size": "{typography.heading.medium.font-size}",
        "line-height": "{typography.heading.medium.line-height}",
        "letter-spacing": "{typography.heading.medium.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "bold"
      },
      "declarations": {
        "font-weight": "{typography.weight.bold}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "xxlarge"
      },
      "declarations": {
        "font-family": "{typography.heading.xxlarge.font-family}",
        "font-size": "{typography.heading.xxlarge.font-size}",
        "line-height": "{typography.heading.xxlarge.line-height}",
        "letter-spacing": "{typography.heading.xxlarge.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "xlarge"
      },
      "declarations": {
        "font-family": "{typography.heading.xlarge.font-family}",
        "font-size": "{typography.heading.xlarge.font-size}",
        "line-height": "{typography.heading.xlarge.line-height}",
        "letter-spacing": "{typography.heading.xlarge.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "large"
      },
      "declarations": {
        "font-family": "{typography.heading.large.font-family}",
        "font-size": "{typography.heading.large.font-size}",
        "line-height": "{typography.heading.large.line-height}",
        "letter-spacing": "{typography.heading.large.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "small"
      },
      "declarations": {
        "font-family": "{typography.heading.small.font-family}",
        "font-size": "{typography.heading.small.font-size}",
        "line-height": "{typography.heading.small.line-height}",
        "letter-spacing": "{typography.heading.small.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "xsmall"
      },
      "declarations": {
        "font-family": "{typography.heading.xsmall.font-family}",
        "font-size": "{typography.heading.xsmall.font-size}",
        "line-height": "{typography.heading.xsmall.line-height}",
        "letter-spacing": "{typography.heading.xsmall.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "semibold"
      },
      "declarations": {
        "font-weight": "{typography.weight.semibold}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "medium"
      },
      "declarations": {
        "font-weight": "{typography.weight.medium}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "regular"
      },
      "declarations": {
        "font-weight": "{typography.weight.regular}"
      }
    }
  ],
  "hookScope": "Set a hook on a scope the product owns, not on :root, so a runtime change restyles that scope only, for example .promo { --scnx-heading-color: …; }.",
  "hooks": [
    {
      "hook": "--scnx-heading-color",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.neutral.text.default.default}"
      ],
      "floor": null,
      "purpose": "The color of Heading.",
      "coverage": "industrial and achromatic, light and dark; every size and weight value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-heading-font-family",
      "parts": [
        "root"
      ],
      "properties": [
        "font-family"
      ],
      "fallbacks": [
        "{typography.heading.large.font-family}",
        "{typography.heading.medium.font-family}",
        "{typography.heading.small.font-family}",
        "{typography.heading.xlarge.font-family}",
        "{typography.heading.xsmall.font-family}",
        "{typography.heading.xxlarge.font-family}"
      ],
      "floor": null,
      "purpose": "The font-family of Heading.",
      "coverage": "industrial and achromatic, light and dark; every size and weight value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-heading-font-size",
      "parts": [
        "root"
      ],
      "properties": [
        "font-size"
      ],
      "fallbacks": [
        "{typography.heading.large.font-size}",
        "{typography.heading.medium.font-size}",
        "{typography.heading.small.font-size}",
        "{typography.heading.xlarge.font-size}",
        "{typography.heading.xsmall.font-size}",
        "{typography.heading.xxlarge.font-size}"
      ],
      "floor": null,
      "purpose": "The font-size of Heading.",
      "coverage": "industrial and achromatic, light and dark; every size and weight value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-heading-font-weight",
      "parts": [
        "root"
      ],
      "properties": [
        "font-weight"
      ],
      "fallbacks": [
        "{typography.weight.bold}",
        "{typography.weight.medium}",
        "{typography.weight.regular}",
        "{typography.weight.semibold}"
      ],
      "floor": null,
      "purpose": "The font-weight of Heading.",
      "coverage": "industrial and achromatic, light and dark; every size and weight value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-heading-letter-spacing",
      "parts": [
        "root"
      ],
      "properties": [
        "letter-spacing"
      ],
      "fallbacks": [
        "{typography.heading.large.letter-spacing}",
        "{typography.heading.medium.letter-spacing}",
        "{typography.heading.small.letter-spacing}",
        "{typography.heading.xlarge.letter-spacing}",
        "{typography.heading.xsmall.letter-spacing}",
        "{typography.heading.xxlarge.letter-spacing}"
      ],
      "floor": null,
      "purpose": "The letter-spacing of Heading.",
      "coverage": "industrial and achromatic, light and dark; every size and weight value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-heading-line-height",
      "parts": [
        "root"
      ],
      "properties": [
        "line-height"
      ],
      "fallbacks": [
        "{typography.heading.large.line-height}",
        "{typography.heading.medium.line-height}",
        "{typography.heading.small.line-height}",
        "{typography.heading.xlarge.line-height}",
        "{typography.heading.xsmall.line-height}",
        "{typography.heading.xxlarge.line-height}"
      ],
      "floor": null,
      "purpose": "The line-height of Heading.",
      "coverage": "industrial and achromatic, light and dark; every size and weight value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    }
  ]
}
