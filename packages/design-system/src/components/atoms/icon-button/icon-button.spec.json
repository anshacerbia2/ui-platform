{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/icon-button",
  "entryKind": "interactive",
  "stability": "candidate",
  "primitive": "ButtonBase",
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-icon-button",
      "primitivePart": "button"
    }
  ],
  "options": {
    "variant": {
      "values": [
        "primary",
        "secondary",
        "ghost",
        "danger"
      ],
      "default": "secondary",
      "selector": "[data-variant={value}]"
    },
    "size": {
      "values": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "selector": "[data-size={value}]"
    },
    "shape": {
      "values": [
        "square",
        "circular"
      ],
      "default": "square",
      "selector": "[data-shape={value}]"
    }
  },
  "states": [
    {
      "name": "hover",
      "selectors": [
        ":hover:not(:disabled, [data-disabled])"
      ],
      "enter": {
        "interaction": "hover"
      }
    },
    {
      "name": "pressed",
      "selectors": [
        ":active:not(:disabled, [data-disabled])"
      ],
      "enter": {
        "interaction": "press"
      }
    },
    {
      "name": "disabled",
      "selectors": [
        ":disabled",
        "[data-disabled]"
      ],
      "enter": {
        "props": {
          "disabled": true
        }
      }
    }
  ],
  "fixture": {
    "props": {
      "aria-label": "Close",
      "children": "×"
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "border-radius": "{dimension.radius.control}",
        "border": "{dimension.border-width.default} solid transparent",
        "transition-duration": "{motion.feedback.duration}",
        "transition-timing-function": "{motion.feedback.easing}",
        "inline-size": "max(24px, {dimension.size.control-default})",
        "block-size": "max(24px, {dimension.size.control-default})"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "small"
      },
      "declarations": {
        "border-radius": "{dimension.radius.element}",
        "inline-size": "max(24px, {dimension.size.control-compact})",
        "block-size": "max(24px, {dimension.size.control-compact})"
      }
    },
    {
      "part": "root",
      "option": {
        "shape": "circular"
      },
      "declarations": {
        "border-radius": "50%"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "declarations": {
        "background": "{color.neutral.surface.solid.default}",
        "color": "{color.neutral.text.contrast.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "state": "hover",
      "declarations": {
        "background": "{color.neutral.surface.solid.hover}",
        "color": "{color.neutral.text.contrast.hover}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "state": "pressed",
      "declarations": {
        "background": "{color.neutral.surface.solid.pressed}",
        "color": "{color.neutral.text.contrast.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "state": "disabled",
      "declarations": {
        "background": "{color.neutral.surface.solid.disabled}",
        "color": "{color.neutral.text.contrast.disabled}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "declarations": {
        "background": "{color.neutral.surface.raised.default}",
        "color": "{color.neutral.text.default.default}",
        "box-shadow": "{effect.material.raised}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "state": "hover",
      "declarations": {
        "background": "{color.neutral.surface.subtle.hover}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "state": "pressed",
      "declarations": {
        "background": "{color.neutral.surface.subtle.pressed}",
        "box-shadow": "{effect.material.flat}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "state": "disabled",
      "declarations": {
        "background": "{color.neutral.surface.default.disabled}",
        "color": "{color.neutral.text.default.disabled}",
        "box-shadow": "{effect.material.flat}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "ghost"
      },
      "declarations": {
        "background": "transparent",
        "color": "{color.neutral.icon.subtle.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "ghost"
      },
      "state": "hover",
      "declarations": {
        "background": "{color.neutral.surface.subtle.hover}",
        "color": "{color.neutral.icon.subtle.hover}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "ghost"
      },
      "state": "pressed",
      "declarations": {
        "background": "{color.neutral.surface.subtle.pressed}",
        "color": "{color.neutral.icon.subtle.hover}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "ghost"
      },
      "state": "disabled",
      "declarations": {
        "background": "transparent",
        "color": "{color.neutral.icon.default.disabled}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "danger"
      },
      "declarations": {
        "background": "{color.danger.surface.solid.default}",
        "color": "{color.danger.text.contrast.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "danger"
      },
      "state": "hover",
      "declarations": {
        "background": "{color.danger.surface.solid.hover}",
        "color": "{color.danger.text.contrast.hover}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "danger"
      },
      "state": "pressed",
      "declarations": {
        "background": "{color.danger.surface.solid.pressed}",
        "color": "{color.danger.text.contrast.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "danger"
      },
      "state": "disabled",
      "declarations": {
        "background": "{color.danger.surface.solid.disabled}",
        "color": "{color.danger.text.contrast.disabled}"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "large"
      },
      "declarations": {
        "inline-size": "max(24px, {dimension.size.control-comfortable})",
        "block-size": "max(24px, {dimension.size.control-comfortable})"
      }
    }
  ],
  "hookScope": "Set a hook on a scope the product owns, not on :root, so a runtime change restyles that scope only. To change one variant only, set the hook on [data-variant] within the scope, for example .promo [data-variant=\"primary\"] { --scnx-icon-button-background-hover: …; }; without it, the hook applies to every variant in the scope.",
  "hooks": [
    {
      "hook": "--scnx-icon-button-background",
      "parts": [
        "root"
      ],
      "properties": [
        "background"
      ],
      "fallbacks": [
        "transparent",
        "{color.danger.surface.solid.default}",
        "{color.neutral.surface.raised.default}",
        "{color.neutral.surface.solid.default}"
      ],
      "floor": null,
      "purpose": "The background of IconButton.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-background-disabled",
      "parts": [
        "root"
      ],
      "properties": [
        "background"
      ],
      "fallbacks": [
        "transparent",
        "{color.danger.surface.solid.disabled}",
        "{color.neutral.surface.default.disabled}",
        "{color.neutral.surface.solid.disabled}"
      ],
      "floor": null,
      "purpose": "The background of IconButton in the disabled state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-background-hover",
      "parts": [
        "root"
      ],
      "properties": [
        "background"
      ],
      "fallbacks": [
        "{color.danger.surface.solid.hover}",
        "{color.neutral.surface.solid.hover}",
        "{color.neutral.surface.subtle.hover}"
      ],
      "floor": null,
      "purpose": "The background of IconButton in the hover state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-background-pressed",
      "parts": [
        "root"
      ],
      "properties": [
        "background"
      ],
      "fallbacks": [
        "{color.danger.surface.solid.pressed}",
        "{color.neutral.surface.solid.pressed}",
        "{color.neutral.surface.subtle.pressed}"
      ],
      "floor": null,
      "purpose": "The background of IconButton in the pressed state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-border-width",
      "parts": [
        "root"
      ],
      "properties": [
        "border"
      ],
      "fallbacks": [
        "{dimension.border-width.default}"
      ],
      "floor": null,
      "purpose": "The border of IconButton.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-color",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.danger.text.contrast.default}",
        "{color.neutral.icon.subtle.default}",
        "{color.neutral.text.contrast.default}",
        "{color.neutral.text.default.default}"
      ],
      "floor": null,
      "purpose": "The color of IconButton.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-color-disabled",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.danger.text.contrast.disabled}",
        "{color.neutral.icon.default.disabled}",
        "{color.neutral.text.contrast.disabled}",
        "{color.neutral.text.default.disabled}"
      ],
      "floor": null,
      "purpose": "The color of IconButton in the disabled state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-color-hover",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.danger.text.contrast.hover}",
        "{color.neutral.icon.subtle.hover}",
        "{color.neutral.text.contrast.hover}"
      ],
      "floor": null,
      "purpose": "The color of IconButton in the hover state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-color-pressed",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.danger.text.contrast.default}",
        "{color.neutral.icon.subtle.hover}",
        "{color.neutral.text.contrast.default}"
      ],
      "floor": null,
      "purpose": "The color of IconButton in the pressed state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-radius",
      "parts": [
        "root"
      ],
      "properties": [
        "border-radius"
      ],
      "fallbacks": [
        "{dimension.radius.control}",
        "{dimension.radius.element}"
      ],
      "floor": null,
      "purpose": "The border-radius of IconButton's square shape.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value; not shape circular, whose circle is anatomy (50%) and ignores this hook.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-shadow",
      "parts": [
        "root"
      ],
      "properties": [
        "box-shadow"
      ],
      "fallbacks": [
        "{effect.material.raised}"
      ],
      "floor": null,
      "purpose": "The box-shadow of IconButton.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-shadow-disabled",
      "parts": [
        "root"
      ],
      "properties": [
        "box-shadow"
      ],
      "fallbacks": [
        "{effect.material.flat}"
      ],
      "floor": null,
      "purpose": "The box-shadow of IconButton in the disabled state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-shadow-pressed",
      "parts": [
        "root"
      ],
      "properties": [
        "box-shadow"
      ],
      "fallbacks": [
        "{effect.material.flat}"
      ],
      "floor": null,
      "purpose": "The box-shadow of IconButton in the pressed state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-size",
      "parts": [
        "root"
      ],
      "properties": [
        "block-size",
        "inline-size"
      ],
      "fallbacks": [
        "{dimension.size.control-comfortable}",
        "{dimension.size.control-compact}",
        "{dimension.size.control-default}"
      ],
      "floor": "24px",
      "purpose": "The block-size and inline-size of IconButton.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value; never below the 24px floor.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-transition-duration",
      "parts": [
        "root"
      ],
      "properties": [
        "transition-duration"
      ],
      "fallbacks": [
        "{motion.feedback.duration}"
      ],
      "floor": null,
      "purpose": "The transition-duration of IconButton.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-transition-timing-function",
      "parts": [
        "root"
      ],
      "properties": [
        "transition-timing-function"
      ],
      "fallbacks": [
        "{motion.feedback.easing}"
      ],
      "floor": null,
      "purpose": "The transition-timing-function of IconButton.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-icon-button-translate-pressed",
      "parts": [
        "root"
      ],
      "properties": [
        "translate"
      ],
      "fallbacks": [
        "0 1px"
      ],
      "floor": null,
      "purpose": "The translate of IconButton in the pressed state.",
      "coverage": "industrial and achromatic, light and dark; every variant and size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    }
  ],
  "geometry": [
    {
      "part": "root",
      "declarations": {
        "aspect-ratio": "1"
      }
    }
  ]
}
