{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/button",
  "entryKind": "interactive",
  "stability": "candidate",
  "primitive": "ButtonBase",
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-button",
      "primitivePart": "button"
    }
  ],
  "options": {
    "variant": {
      "values": [
        "primary",
        "secondary",
        "ghost",
        "danger"
      ],
      "default": "primary",
      "selector": "[data-variant={value}]"
    },
    "size": {
      "values": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "selector": "[data-size={value}]"
    }
  },
  "states": [
    {
      "name": "hover",
      "selectors": [
        ":hover:not(:disabled, [data-disabled])"
      ],
      "enter": {
        "interaction": "hover"
      }
    },
    {
      "name": "pressed",
      "selectors": [
        ":active:not(:disabled, [data-disabled])"
      ],
      "enter": {
        "interaction": "press"
      }
    },
    {
      "name": "disabled",
      "selectors": [
        ":disabled",
        "[data-disabled]"
      ],
      "enter": {
        "props": {
          "disabled": true
        }
      }
    }
  ],
  "fixture": {
    "props": {
      "children": "Save changes"
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "gap": "{dimension.spacing.inline-default}",
        "padding-inline": "{dimension.spacing.control-default}",
        "border": "{dimension.border-width.default} solid transparent",
        "border-radius": "{dimension.radius.control}",
        "font-family": "{typography.label.default.font-family}",
        "font-size": "{typography.label.default.font-size}",
        "line-height": "{typography.label.default.line-height}",
        "letter-spacing": "{typography.label.default.letter-spacing}",
        "font-weight": "{typography.weight.semibold}",
        "transition-duration": "{motion.feedback.duration}",
        "transition-timing-function": "{motion.feedback.easing}",
        "block-size": "max(24px, {dimension.size.control-default})"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "small"
      },
      "declarations": {
        "gap": "{dimension.spacing.inline-compact}",
        "padding-inline": "{dimension.spacing.control-compact}",
        "border-radius": "{dimension.radius.element}",
        "font-size": "{typography.label.small.font-size}",
        "block-size": "max(24px, {dimension.size.control-compact})"
      }
    },
    {
      "part": "root",
      "option": {
        "size": "large"
      },
      "declarations": {
        "padding-inline": "{dimension.spacing.control-comfortable}",
        "font-size": "{typography.body.default.font-size}",
        "block-size": "max(24px, {dimension.size.control-comfortable})"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "declarations": {
        "background": "{color.neutral.surface.solid.default}",
        "color": "{color.neutral.text.contrast.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "state": "hover",
      "declarations": {
        "background": "{color.neutral.surface.solid.hover}",
        "color": "{color.neutral.text.contrast.hover}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "state": "pressed",
      "declarations": {
        "background": "{color.neutral.surface.solid.pressed}",
        "color": "{color.neutral.text.contrast.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "primary"
      },
      "state": "disabled",
      "declarations": {
        "background": "{color.neutral.surface.solid.disabled}",
        "color": "{color.neutral.text.contrast.disabled}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "declarations": {
        "background": "{color.neutral.surface.raised.default}",
        "color": "{color.neutral.text.default.default}",
        "box-shadow": "{effect.material.raised}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "state": "hover",
      "declarations": {
        "background": "{color.neutral.surface.subtle.hover}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "state": "pressed",
      "declarations": {
        "background": "{color.neutral.surface.subtle.pressed}",
        "box-shadow": "{effect.material.flat}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "secondary"
      },
      "state": "disabled",
      "declarations": {
        "background": "{color.neutral.surface.default.disabled}",
        "color": "{color.neutral.text.default.disabled}",
        "box-shadow": "{effect.material.flat}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "ghost"
      },
      "declarations": {
        "background": "transparent",
        "color": "{color.neutral.text.default.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "ghost"
      },
      "state": "hover",
      "declarations": {
        "background": "{color.neutral.surface.subtle.hover}"
