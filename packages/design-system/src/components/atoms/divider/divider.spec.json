      "selector": "[data-weight={value}]"
    },
    "color": {
      "values": [
        "default",
        "muted",
        "primary"
      ],
      "default": "default",
      "selector": "[data-color={value}]"
    }
  },
  "states": [],
  "fixture": {
    "props": {}
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "background-color": "{color.neutral.border.default.default}"
      }
