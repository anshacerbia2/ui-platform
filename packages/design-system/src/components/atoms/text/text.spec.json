{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/text",
  "entryKind": "presentational",
  "stability": "candidate",
  "primitive": null,
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-text"
    }
  ],
  "options": {
    "variant": {
      "values": [
        "body-large",
        "body-default",
        "body-small",
        "label-default",
        "label-small"
      ],
      "default": "body-default",
      "selector": ".scnx-text--variant_{value}"
    },
    "weight": {
      "values": [
        "bold",
        "semibold",
        "medium",
        "regular"
      ],
      "default": null,
      "selector": ".scnx-text--weight_{value}"
    },
    "align": {
      "values": [
        "left",
        "center",
        "right"
      ],
      "default": "left",
      "selector": ".scnx-text--align_{value}"
    },
    "dimmed": {
      "values": [
        "false",
        "true"
      ],
      "default": null,
      "selector": ".scnx-text--dimmed_{value}"
    }
  },
  "states": [],
  "fixture": {
    "props": {
      "children": "Net pay is paid on the last working day."
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "color": "{color.neutral.text.default.default}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "body-default"
      },
      "declarations": {
        "font-family": "{typography.body.default.font-family}",
        "font-size": "{typography.body.default.font-size}",
        "font-weight": "{typography.body.default.font-weight}",
        "line-height": "{typography.body.default.line-height}",
        "letter-spacing": "{typography.body.default.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "body-large"
      },
      "declarations": {
        "font-family": "{typography.body.large.font-family}",
        "font-size": "{typography.body.large.font-size}",
        "font-weight": "{typography.body.large.font-weight}",
        "line-height": "{typography.body.large.line-height}",
        "letter-spacing": "{typography.body.large.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "body-small"
      },
      "declarations": {
        "font-family": "{typography.body.small.font-family}",
        "font-size": "{typography.body.small.font-size}",
        "font-weight": "{typography.body.small.font-weight}",
        "line-height": "{typography.body.small.line-height}",
        "letter-spacing": "{typography.body.small.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "label-default"
      },
      "declarations": {
        "font-family": "{typography.label.default.font-family}",
        "font-size": "{typography.label.default.font-size}",
        "font-weight": "{typography.label.default.font-weight}",
        "line-height": "{typography.label.default.line-height}",
        "letter-spacing": "{typography.label.default.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "variant": "label-small"
      },
      "declarations": {
        "font-family": "{typography.label.small.font-family}",
        "font-size": "{typography.label.small.font-size}",
        "font-weight": "{typography.label.small.font-weight}",
        "line-height": "{typography.label.small.line-height}",
        "letter-spacing": "{typography.label.small.letter-spacing}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "bold"
      },
      "declarations": {
        "font-weight": "{typography.weight.bold}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "semibold"
      },
      "declarations": {
        "font-weight": "{typography.weight.semibold}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "medium"
      },
      "declarations": {
        "font-weight": "{typography.weight.medium}"
      }
    },
    {
      "part": "root",
      "option": {
        "weight": "regular"
      },
      "declarations": {
        "font-weight": "{typography.weight.regular}"
      }
    },
    {
      "part": "root",
      "option": {
        "dimmed": "true"
      },
      "declarations": {
        "color": "{color.neutral.text.subtle.default}"
      }
    }
  ],
  "hookScope": "Set a hook on a scope the product owns, not on :root, so a runtime change restyles that scope only, for example .promo { --scnx-text-color: …; }.",
  "hooks": [
    {
      "hook": "--scnx-text-color",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.neutral.text.default.default}"
      ],
      "floor": null,
      "purpose": "The color of Text.",
      "coverage": "industrial and achromatic, light and dark; every variant, weight, align and dimmed value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-text-color-dimmed",
      "parts": [
        "root"
      ],
      "properties": [
        "color"
      ],
      "fallbacks": [
        "{color.neutral.text.subtle.default}"
      ],
      "floor": null,
      "purpose": "The color of Text.",
      "coverage": "industrial and achromatic, light and dark; every variant, weight, align and dimmed value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-text-font-family",
      "parts": [
        "root"
      ],
      "properties": [
        "font-family"
      ],
      "fallbacks": [
        "{typography.body.default.font-family}",
        "{typography.body.large.font-family}",
        "{typography.body.small.font-family}",
        "{typography.label.default.font-family}",
        "{typography.label.small.font-family}"
      ],
      "floor": null,
      "purpose": "The font-family of Text.",
      "coverage": "industrial and achromatic, light and dark; every variant, weight, align and dimmed value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-text-font-size",
      "parts": [
        "root"
      ],
      "properties": [
        "font-size"
      ],
      "fallbacks": [
        "{typography.body.default.font-size}",
        "{typography.body.large.font-size}",
        "{typography.body.small.font-size}",
        "{typography.label.default.font-size}",
        "{typography.label.small.font-size}"
      ],
      "floor": null,
      "purpose": "The font-size of Text.",
      "coverage": "industrial and achromatic, light and dark; every variant, weight, align and dimmed value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-text-font-weight",
      "parts": [
        "root"
      ],
      "properties": [
        "font-weight"
      ],
      "fallbacks": [
        "{typography.body.default.font-weight}",
        "{typography.body.large.font-weight}",
        "{typography.body.small.font-weight}",
        "{typography.label.default.font-weight}",
        "{typography.label.small.font-weight}",
        "{typography.weight.bold}",
        "{typography.weight.medium}",
        "{typography.weight.regular}",
        "{typography.weight.semibold}"
      ],
      "floor": null,
      "purpose": "The font-weight of Text.",
      "coverage": "industrial and achromatic, light and dark; every variant, weight, align and dimmed value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-text-letter-spacing",
      "parts": [
        "root"
      ],
      "properties": [
        "letter-spacing"
      ],
      "fallbacks": [
        "{typography.body.default.letter-spacing}",
        "{typography.body.large.letter-spacing}",
        "{typography.body.small.letter-spacing}",
        "{typography.label.default.letter-spacing}",
        "{typography.label.small.letter-spacing}"
      ],
      "floor": null,
      "purpose": "The letter-spacing of Text.",
      "coverage": "industrial and achromatic, light and dark; every variant, weight, align and dimmed value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-text-line-height",
      "parts": [
        "root"
      ],
      "properties": [
        "line-height"
      ],
      "fallbacks": [
        "{typography.body.default.line-height}",
        "{typography.body.large.line-height}",
        "{typography.body.small.line-height}",
        "{typography.label.default.line-height}",
        "{typography.label.small.line-height}"
      ],
      "floor": null,
      "purpose": "The line-height of Text.",
      "coverage": "industrial and achromatic, light and dark; every variant, weight, align and dimmed value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    }
  ]
}
