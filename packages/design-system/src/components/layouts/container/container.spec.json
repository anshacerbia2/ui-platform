{
  "$schema": "../../../../../../scripts/specs/schema/styled.schema.json",
  "kind": "styled",
  "entry": "@scnx/system/components/container",
  "entryKind": "presentational",
  "stability": "candidate",
  "primitive": null,
  "anatomy": [
    {
      "name": "root",
      "selector": ".scnx-container"
    }
  ],
  "options": {
    "size": {
      "values": [
        "prose",
        "base",
        "wide",
        "fluid"
      ],
      "default": "base",
      "selector": ".scnx-container--size_{value}"
    }
  },
  "states": [],
  "fixture": {
    "props": {
      "children": "Content"
    }
  },
  "bindings": [
    {
      "part": "root",
      "declarations": {
        "padding-inline": "{dimension.spacing.page}"
      }
    }
  ],
  "hookScope": "Set a hook on a scope the product owns, not on :root, so a runtime change restyles that scope only, for example .promo { --scnx-container-max-width: …; }.",
  "hooks": [
    {
      "hook": "--scnx-container-max-width",
      "parts": [
        "root"
      ],
      "properties": [
        "max-width"
      ],
      "fallbacks": [
        "1024px",
        "1440px",
        "65ch"
      ],
      "floor": null,
      "purpose": "The max-width of Container.",
      "coverage": "scnx-platform and scnx-saas, light and dark; every size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    },
    {
      "hook": "--scnx-container-padding-inline",
      "parts": [
        "root"
      ],
      "properties": [
        "padding-inline"
      ],
      "fallbacks": [
        "{dimension.spacing.page}"
      ],
      "floor": null,
      "purpose": "The padding-inline of Container.",
      "coverage": "scnx-platform and scnx-saas, light and dark; every size value.",
      "migration": "Added in @scnx/system 2.0.0-beta.0, before v1; additive, no consumer change."
    }
  ]
}
