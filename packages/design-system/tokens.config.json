{
  "schemaVersion": 1,
  "sourceRoot": "src",
  "themes": {
    "scnx-platform": {
      "modes": {
        "light": { "module": "styles/themes/scnx-platform/scnx-platform-token", "variable": "scnx-platform-token" },
        "dark": { "module": "styles/themes/scnx-platform/scnx-platform-dark-token", "variable": "dark-token" }
      }
    },
    "scnx-saas": {
      "inherits": "scnx-platform",
      "modes": {
        "light": { "module": "styles/themes/scnx-saas/scnx-saas-light-token", "variable": "scnx-saas-light-token" },
        "dark": { "module": "styles/themes/scnx-saas/scnx-saas-dark-token", "variable": "scnx-saas-dark-token" }
      }
    }
  },
  "fonts": {
    "system": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "Menlo", "Consolas", "SFMono-Regular"],
    "assets": {
      "Inter": {
        "faces": [
          { "source": "assets/fonts/Inter-VariableFont_opsz,wght.woff2", "publish": "fonts/inter-variable.woff2", "style": "normal", "weight": "100 900" },
          { "source": "assets/fonts/Inter-Italic-VariableFont_opsz,wght.woff2", "publish": "fonts/inter-italic-variable.woff2", "style": "italic", "weight": "100 900" }
        ],
        "license": { "source": "assets/fonts/OFL.txt", "publish": "fonts/inter-ofl.txt" }
      }
    }
  },
  "contrast": {
    "textMinimum": 4.5,
    "nonTextMinimum": 3,
    "canvas": "--ds-color-neutral-surface-canvas-default",
    "neutralBackgrounds": [
      "--ds-color-neutral-surface-canvas-default",
      "--ds-color-neutral-surface-sunken-default",
      "--ds-color-neutral-surface-raised-default",
      "--ds-color-neutral-surface-floating-default",
      "--ds-color-neutral-surface-subtle-default",
      "--ds-color-neutral-surface-default-default",
      "--ds-color-neutral-surface-stage-default"
    ]
  },
  "aliases": {}
}
