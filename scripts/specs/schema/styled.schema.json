{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anshacerbia2/ui-platform/blob/main/scripts/specs/schema/styled.schema.json",
  "title": "Styled specification: the presentation contract of an @scnx/system component (ADR-UIP-CMP-001; TDD styled CS1-CS8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "entry",
    "entryKind",
    "stability",
    "primitive",
    "anatomy",
    "options",
    "states",
    "fixture",
    "bindings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "styled"
    },
    "entry": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/entry"
        },
        {
          "type": "string",
          "pattern": "^@scnx/system/components/"
        }
      ]
    },
    "entryKind": {
      "enum": [
        "presentational",
        "interactive",
        "layout",
        "motion"
      ]
    },
    "stability": {
      "$ref": "common.schema.json#/$defs/stability"
    },
    "primitive": {
      "description": "Name of the primitive specification this component styles, or null.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Za-z]*Base$"
    },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "selector"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "selector": {
            "description": "The part's selector in the published stylesheet: the root's class for the first part; for the others, one or more compounds starting with a .scnx- class (a BEM element, the root followed by a combinator, or another part followed by a combinator), or a pseudo-element.",
            "type": "string",
            "pattern": "^\\.scnx-[a-z0-9_-]+"
          },
          "primitivePart": {
            "description": "The primitive part this part styles.",
            "$ref": "common.schema.json#/$defs/name"
          },
          "extends": {
            "description": "A part this part refines, whose bindings it also takes (a nested list).",
            "$ref": "common.schema.json#/$defs/name"
          }
        }
      }
    },
    "options": {
      "description": "Styling options; each value is selected by a selector fragment on the root part.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "values",
          "default",
          "selector"
        ],
        "properties": {
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "default": {
            "description": "The value the component applies when the prop is absent, or null when it applies none.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "selector": {
            "description": "Selector fragment with {value}: appended to the root's class (for example [data-variant={value}]), or a class on the root element when it starts with a period (for example .heading--size_{value}).",
            "type": "string",
            "pattern": "\\{value\\}"
          }
        }
      }
    },
    "states": {
      "description": "Visual states besides the rest state; each is matched by one or more selector fragments and entered by props or an interaction.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "selectors",
          "enter"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "enter": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "props"
                ],
                "properties": {
                  "props": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "interaction"
                ],
                "properties": {
                  "interaction": {
                    "enum": [
                      "hover",
                      "press",
                      "focus",
                      "focus-within"
                    ],
                    "description": "hover and press use the pointer; focus focuses the element, focus-within its first focusable descendant."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fixture"
                ],
                "properties": {
                  "fixture": {
                    "const": true,
                    "description": "The fixture tree already renders elements in this state."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attribute"
                ],
                "properties": {
                  "attribute": {
                    "type": "object",
                    "description": "Attributes the fixture sets on the element for the measurement, for a state the primitive sets at run time (a table of contents marks the section in view).",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "on": {
            "description": "Where the state's selector fragment attaches: the root part, the measured part (default), or the named part written as the measured part's context.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "fixture": {
      "description": "How the conformance fixture renders the component. `props` renders the component itself; `tree` renders a node tree whose root is the component (`type` names an export, `Name.Sub` a sub-component, or a lowercase HTML element). Option values and prop-entered states are passed to the root node.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "type": "object",
          "required": [
            "props"
          ],
          "properties": {
            "props": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "tree"
          ],
          "properties": {
            "tree": {
              "$ref": "#/$defs/node"
            }
          }
        }
      ],
      "properties": {
        "props": {
          "type": "object"
        },
        "tree": {
          "$ref": "#/$defs/node"
        },
        "activate": {
          "description": "A method called on the root element before measuring and undone after, for example showModal for a native dialog.",
          "enum": [
            "showModal"
          ]
        }
      }
    },
    "bindings": {
      "description": "Every token-bearing declaration of the component's stylesheet, and every literal override of a token-bound property, by part, option value, and state.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "declarations"
        ],
        "properties": {
          "part": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "option": {
            "type": "object",
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/name"
            }
          },
          "state": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "declarations": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z-]+$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Declared values with each token as {token.path}; a literal value records an override of a property the part binds to a token elsewhere."
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^([A-Z][A-Za-z]*(\\.[A-Z][A-Za-z]*)?|[a-z][a-z0-9]*)$"
        },
        "props": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/node"
              }
            ]
          }
        }
      }
    }
  }
}
